{
  "name": "moreplay",
  "version": "0.1.0",
  "description": "Fast Android MCP server: no APK install, on-device waits and batching",
  "license": "MIT",
  "type": "module",
  "bin": {
    "moreplay": "dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:agent": "./agent/build.sh && mkdir -p assets && cp agent/build/moreplay.jar assets/",
    "build": "npm run build:agent && tsc",
    "dev": "tsc --watch",
    "test": "tsc && node --test \"test/*.test.mjs\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "author": "JastinXyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JastinXyz/moreplay.git"
  },
  "homepage": "https://github.com/JastinXyz/moreplay#readme",
  "bugs": {
    "url": "https://github.com/JastinXyz/moreplay/issues"
  },
  "keywords": [
    "mcp",
    "android",
    "adb",
    "uiautomator",
    "automation",
    "testing",
    "ai-agent"
  ]
}
