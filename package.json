{
  "name": "droidreplay",
  "version": "0.1.0",
  "description": "Fast Android MCP server: no APK install, on-device waits and batching",
  "license": "MIT",
  "type": "module",
  "bin": {
    "droidreplay": "dist/index.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:agent": "./agent/build.sh && mkdir -p assets && cp agent/build/droidreplay.jar assets/",
    "build": "npm run build:agent && tsc",
    "dev": "tsc --watch",
    "test": "tsc && node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "author": "JastinXyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JastinXyz/droidreplay.git"
  },
  "homepage": "https://github.com/JastinXyz/droidreplay#readme",
  "bugs": {
    "url": "https://github.com/JastinXyz/droidreplay/issues"
  },
  "keywords": [
    "mcp",
    "android",
    "adb",
    "uiautomator",
    "automation",
    "testing",
    "ai-agent"
  ]
}
